# =============================================================================
# Driveplexity — .gitignore
# Only the benchmark code, results, poster, mock paper and docs are tracked.
# Everything else (side projects, temp scripts, logs, personal files) is ignored.
# =============================================================================

# --- secrets & local env ---
.env
.env.*
!.env.example

# --- side projects (not part of Driveplexity) ---
binsai/
tp_integrador/
ddl/
ecuacion_proaccion/
workshop_neurips/
research/
utility_prompts/
static/
lib/

# --- personal / application files ---
