plan_consofi.md
prompt_consofi.txt
CONTEXT.md
.claude/
.cascadeignore

# --- old / superseded papers ---
paper_jaiio*
paper_iterations/
docs/poster_langclaw.html

# --- guide directory (authoring guides, course materials, review PDFs) ---
guide/

# --- python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

